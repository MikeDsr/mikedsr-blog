---
// 全站背景：那幅画固定在页面后面，内容在上面滚动。
// 往下滚动时天色慢慢变成黄昏、星星浮现（--dusk 从 0 到 1）。
// 首页从白天开始；其他页面一进来就是黄昏，保证文字清楚。
import meadow from '../assets/theme/meadow.webp';
import lavender from '../assets/theme/lavender.webp';
import Starfield from './Starfield.astro';

interface Props { dusk?: number }
const { dusk = 1 } = Astro.props;
---
<div class="scene" aria-hidden="true" data-base-dusk={dusk}>
  <picture>
    <source media="(max-width: 700px)" srcset={lavender.src} />
    <img src={meadow.src} alt="" class="scene-img" fetchpriority="high" />
  </picture>
  <div class="scene-dusk"></div>
  <div class="scene-stars"><Starfield /></div>
</div>
<script is:inline>
  (function () {
    var scene = document.currentScript.previousElementSibling;
    var base = parseFloat(scene.dataset.baseDusk || '1');
    var root = document.documentElement;
    var ticking = false;
    function update() {
      ticking = false;
      var t = Math.min(1, window.scrollY / (window.innerHeight * 0.75));
      root.style.setProperty('--dusk', String(Math.max(base, t)));
    }
    update();
    addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  })();
</script>
