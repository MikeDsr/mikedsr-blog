---
import { SITE_TITLE, AUTHOR } from '../consts';
const sha = (process.env.WORKERS_CI_COMMIT_SHA ?? 'local').slice(0, 7);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-left">
    <span class="footer-title">{SITE_TITLE}</span>
    <span>© {year} {AUTHOR}</span>
    <span class="footer-dim">rev {sha}</span>
  </div>
  <div class="footer-right">
    <span class="footer-dim">插画来自网络，版权归原作者所有</span>
    <a href="/rss.xml">RSS 订阅</a>
  </div>
</footer>
