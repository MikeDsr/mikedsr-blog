---
// 部署到 Cloudflare 时会提供当前提交的哈希；本地开发显示 local
const sha = (process.env.WORKERS_CI_COMMIT_SHA ?? 'local').slice(0, 7);
const built = new Date().toISOString().slice(0, 10);
---
<footer class="footer">
  <div class="footer-silk">
    <span>U4</span>
    <span>blog.mikedsr.top</span>
    <span>rev {sha}</span>
    <span>{built}</span>
  </div>
  <div class="footer-links">
    <span>照片来自 <a href="https://unsplash.com/license">Unsplash</a></span>
    <a href="/rss.xml">RSS 订阅</a>
  </div>
</footer>
