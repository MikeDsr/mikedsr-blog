---
import { Image } from 'astro:assets';
import avatar from '../assets/theme/avatar.webp';
import { SITE_TITLE } from '../consts';
---
<header class="bus">
  <nav class="bus-inner">
    <a href="/" class="brand">
      <Image src={avatar} alt="" width={64} class="brand-avatar" loading="eager" />
      <span>{SITE_TITLE}</span>
    </a>
    <span class="bus-spacer"></span>
    <mike-term current="blog" paths="about:/about/,archive:/archive/,tags:/tags/,search:/search/"></mike-term>
    <a href="/about/" class="bus-link">关于</a>
    <a href="/archive/" class="bus-link">归档</a>
    <a href="/tags/" class="bus-link">标签</a>
    <a href="/search/" class="bus-link">搜索</a>
  </nav>
</header>
