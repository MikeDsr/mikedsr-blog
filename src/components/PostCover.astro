---
// 文章封面：优先用文章开头 cover 指定的图片，没有就从主题图里挑一张
import { Image } from 'astro:assets';
import { findPhoto, defaultCover } from '../lib/photos';
import type { Post } from '../lib/posts';

interface Props { post: Post; width?: number; class?: string; eager?: boolean }
const { post, width = 640, class: cls, eager = false } = Astro.props;
const photo = findPhoto(post.data.cover) ?? defaultCover(post.id);
---
{photo && (
  <Image
    src={photo}
    alt={post.data.coverAlt ?? ''}
    width={width}
    class:list={['cover-img', cls]}
    loading={eager ? 'eager' : 'lazy'}
  />
)}
