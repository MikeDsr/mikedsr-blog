---
// 没有封面照片时用的插画：一小片动漫风天空，时间段（清晨/白天/黄昏/夜晚）由文章 id 决定
interface Props { seed: string; label?: string; class?: string }
const { seed, label = '', class: cls } = Astro.props;

let h = 2166136261;
for (const c of seed) { h ^= c.codePointAt(0)!; h = Math.imul(h, 16777619) >>> 0; }
const rnd = () => { h ^= h << 13; h >>>= 0; h ^= h >>> 17; h ^= h << 5; h >>>= 0; return h / 4294967296; };
const pick = (a: number, b: number) => Math.round(a + rnd() * (b - a));

const themes = [
  { top: '#2E7AD6', mid: '#7EC6F3', low: '#FFE6BE', sun: '#FFFBEA', cloud: '#FFFFFF', shade: '#C9E0F6', city: '#3F5F92' }, // 白天
  { top: '#F28AA8', mid: '#FFC3A1', low: '#FFE9B8', sun: '#FFF6D8', cloud: '#FFF3F0', shade: '#F4C2C9', city: '#7A4F7E' }, // 黄昏
  { top: '#8FB7F0', mid: '#CFE4FA', low: '#FFF0F4', sun: '#FFFFFF', cloud: '#FFFFFF', shade: '#DDE7F7', city: '#6C80B0' }, // 清晨
  { top: '#141C3F', mid: '#2C3F7A', low: '#6A5A9A', sun: '#FFF4C8', cloud: '#3B4C86', shade: '#2A386A', city: '#0E1430' }, // 夜晚
];
const t = themes[pick(0, themes.length - 1)];
const night = t === themes[3];
const id = `c${(h >>> 0).toString(36)}`;
const W = 400, H = 250;
const sun = { x: pick(60, 340), y: pick(40, 90) };
const clouds = [...Array(3)].map(() => ({ x: pick(20, 380), y: pick(110, 180), s: 0.35 + rnd() * 0.4 }));
const puffs: [number, number, number][] = [[-60, 6, 38], [-20, -22, 48], [28, -30, 54], [72, -6, 40], [0, 14, 46]];
const stars = night ? [...Array(24)].map(() => [pick(0, W), pick(0, 140), rnd() < 0.2 ? 1.6 : 0.9]) : [];
const wireY = pick(40, 80);
---
<svg class:list={['cover-art', cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={t.top} /><stop offset=".6" stop-color={t.mid} /><stop offset="1" stop-color={t.low} />
    </linearGradient>
  </defs>
  <rect width={W} height={H} fill={`url(#${id}-g)`} />
  {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#FFFFFF" opacity=".85" />)}
  <circle cx={sun.x} cy={sun.y} r={night ? 18 : 26} fill={t.sun} opacity=".95" />
  {clouds.map((c) => (
    <g transform={`translate(${c.x} ${c.y}) scale(${c.s})`}>
      {puffs.map(([x, y, r]) => <circle cx={x + 6} cy={y + 10} r={r} fill={t.shade} />)}
      {puffs.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill={t.cloud} />)}
    </g>
  ))}
  <path d={`M-10 ${wireY} Q200 ${wireY + 50} 410 ${wireY - 6}`} fill="none" stroke="#1F2A44" stroke-width="1.6" opacity=".8" />
  {[...Array(12)].map((_, i) => {
    const bw = 22 + ((i * 37 + pick(0, 9)) % 30), bh = 18 + ((i * 53 + pick(0, 20)) % 60);
    return <rect x={i * 36 - 6} y={H - bh} width={bw} height={bh} fill={t.city} />;
  })}
  {label && (
    <g>
      <rect x="16" y="16" width={label.length * 14 + 22} height="26" rx="13" fill="#FFFFFF" opacity=".9" />
      <text x="27" y="34" font-size="14" fill="#1F2A44" font-family="'PingFang SC','Microsoft YaHei',sans-serif" font-weight="600">{label.slice(0, 8)}</text>
    </g>
  )}
</svg>
