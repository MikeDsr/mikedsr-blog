---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import PostCard from '../components/PostCard.astro';
import avatar from '../assets/theme/avatar.webp';
import { getPosts } from '../lib/posts';
import { SITE_TITLE, SINCE } from '../consts';

const posts = await getPosts();
const tagCount = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const tags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]);
---
<BaseLayout wide bleed intro dusk={0}>
  <Intro slot="intro" />

  <section class="hero" data-hero>
    <div class="hero-inner">
      <Image src={avatar} alt="MikeDsr 的头像" width={192} class="hero-avatar" loading="eager" />
      <h1 class="hero-title">{SITE_TITLE}</h1>
      <p class="hero-quote">仍愿在符号与星光的间隙，为一朵玫瑰驻足。</p>
      <p class="hero-code" aria-hidden="true"><span class="kw">for</span> (<span class="kw">let</span> sunset = 1; sunset &lt;= 44; sunset++) <span class="fn">lookUp</span>();<span class="caret"></span></p>
      <p class="hero-meta">
        <span>MikeDsr，北航 2506</span>
        <span>{posts.length} 篇文章</span>
        <span data-sunsets data-since={SINCE}>看过的日落正在计算</span>
      </p>
    </div>
    <p class="hero-hint">点一下天空，会落下星星；往下滑，天会慢慢黑</p>
  </section>

  <section class="home-list">
    <div class="list-head">
      <h2 class="section-title">文章</h2>
      {tags.length > 0 && (
        <div class="tag-strip" role="group" aria-label="按标签筛选文章">
          <button type="button" class="tag-chip" data-filter="" aria-pressed="true">全部<sup>{posts.length}</sup></button>
          {tags.map(([t, n]) => (
            <button type="button" class="tag-chip" data-filter={t} aria-pressed="false">{t}<sup>{n}</sup></button>
          ))}
        </div>
      )}
    </div>

    {posts.length === 0 ? (
      <p class="empty">还没有文章。在 src/content/posts/ 里新建一个 .md 文件开始写第一篇。</p>
    ) : (
      <ol class="cards">
        {posts.map((post) => <PostCard post={post} />)}
      </ol>
    )}
  </section>

  <script>
    // 从博客开张那天算起，看过了多少次日落
    const sun = document.querySelector<HTMLElement>('[data-sunsets]');
    if (sun) {
      const days = Math.floor((Date.now() - new Date(sun.dataset.since + 'T18:00:00+08:00').getTime()) / 86400000) + 1;
      sun.textContent = days > 0 ? `这里已经看过 ${days} 次日落` : '第一次日落还没到';
    }

    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (hero) {
      // 点一下天空，落下几颗星星
      hero.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a, button')) return;
        const r = hero.getBoundingClientRect();
        const n = still ? 1 : 6;
        for (let i = 0; i < n; i++) {
          const s = document.createElement('span');
          s.className = 'star';
          s.style.left = `${e.clientX - r.left}px`;
          s.style.top = `${e.clientY - r.top}px`;
          s.style.setProperty('--dx', `${(Math.random() - 0.5) * 160}px`);
          s.style.setProperty('--dy', `${40 + Math.random() * 120}px`);
          s.style.setProperty('--s', `${0.6 + Math.random() * 0.9}`);
          s.style.animationDelay = `${i * 40}ms`;
          hero.append(s);
          s.addEventListener('animationend', () => s.remove());
        }
      });
    }

    // 标签筛选
    const cards = [...document.querySelectorAll<HTMLElement>('.card')];
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const tag = b.dataset.filter ?? '';
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        cards.forEach((c) => { c.hidden = !!tag && !(c.dataset.tags ?? '').split('|').includes(tag); });
      });
    }
  </script>
</BaseLayout>
